rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Orders are immutable to every client, including owner-admin sessions.
    // Review/payment/receipt operations go through privileged server functions.
    match /orders/{orderId} {
      allow create, update, delete: if false;
      allow read: if request.auth != null
        && (resource.data.customerUid == request.auth.uid || request.auth.token.admin == true);
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }
    match /paymentBindings/{intentId} {
      allow read, write: if false;
    }
    
    // Products: Publicly readable so the store can display them.
    // Only writable by admins (you via console or admin scripts).
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Markets: Publicly readable.
    match /markets/{marketId} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId == 'promotions' || settingId == 'delivery';
      allow write: if false;
    }
  }
}