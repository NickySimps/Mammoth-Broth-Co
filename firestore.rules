rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Orders: Allow creation by anyone (for checkout). 
    // Deny read/update/delete to public users.
    // (Admin SDK and Cloud Functions bypass these rules)
    match /orders/{orderId} {
      allow create: if false;
      allow read: if request.auth != null
        && (resource.data.customerUid == request.auth.uid || request.auth.token.admin == true);
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Products: Publicly readable so the store can display them.
    // Only writable by admins (you via console or admin scripts).
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Markets: Publicly readable.
    match /markets/{marketId} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId == 'promotions';
      allow write: if false;
    }
  }
}