{
  "hosting": {
    "public": "./",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firebase/**",
      "server/**",
      "tests/**",
      "scripts/**",
      "docs/**",
      "client/**",
      "**/*.log",
      "package*.json",
      "firestore*.json",
      "*.rules",
      "IDEA.md",
      "seed*",
      "generate_qr.py",
      "README*.md"
    ]
  },
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
